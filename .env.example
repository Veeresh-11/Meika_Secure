# Copy to .env for local development. Never commit .env or production secrets.
# Rotate any credentials that have been pasted into chat, tickets, logs, or source control.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=meika_secure_id
DB_USER=meika_auth_service
DB_PASSWORD=replace-with-a-new-database-password

# Generate a fresh 32-byte Ed25519 private key and encode it as 64 hex characters.
SIGNING_PRIVATE_KEY=replace-with-64-hex-characters

# Generate a fresh random secret of at least 32 bytes for JWT signing.
JWT_SECRET_KEY=replace-with-a-new-random-secret-at-least-32-characters
JWT_ISSUER=https://meika.example.com
ALGORITHM=EdDSA

# WebAuthn relying-party settings: use your real HTTPS domain in production.
WEBAUTHN_RP_ID=meika.example.com
WEBAUTHN_EXPECTED_ORIGINS=https://meika.example.com
